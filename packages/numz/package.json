{
  "name": "numz",
  "version": "0.10.2",
  "description": "scientific computing with zikojs",
  "main": "index.js",
  "type": "module",
  "exports": {
    "./*": {
      "import": "./src/*/index.js"
    }
  },
  "scripts": {
    "test:run": "vitest run",
    "dev": "cross-env NODE_ENV=development rollup --config rollup.config.js",
    "watch": "cross-env NODE_ENV=development rollup --config rollup.config.js -w",
    "build": "cross-env NODE_ENV=production rollup --config rollup.config.js"
  },
  "author": "zakaria elalaoui",
  "keywords": [
    "zikojs",
    "math"
  ],
  "license": "MIT",
   "repository": {
    "type": "git",
    "url": "git+https://github.com/zikojs/numz.git",
    "directory": "packages/numz"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "cross-env": "^10.1.0",
    "rollup": "^4.63.1",
    "vitest": "catalog:"
  },
  "dependencies": {
    "ziko": "catalog:"
  }
}
